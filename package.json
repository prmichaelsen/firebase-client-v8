{
  "name": "@prmichaelsen/firebase-client-v8",
  "version": "1.1.1",
  "description": "Firebase client library optimized for Cloudflare Workers and edge runtimes",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsup src/index.ts --format cjs,esm --dts",
    "dev": "tsup src/index.ts --format cjs,esm --dts --watch",
    "type-check": "tsc --noEmit"
  },
  "keywords": [
    "firebase",
    "cloudflare-workers",
    "edge",
    "firestore",
    "authentication",
    "storage"
  ],
  "author": "prmichaelsen",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/prmichaelsen/firebase-client-v8"
  },
  "bugs": {
    "url": "https://github.com/prmichaelsen/firebase-client-v8/issues"
  },
  "homepage": "https://github.com/prmichaelsen/firebase-client-v8#readme",
  "dependencies": {
    "firebase": "^10.7.0"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "tsup": "^8.0.1",
    "typescript": "^5.3.3"
  }
}
